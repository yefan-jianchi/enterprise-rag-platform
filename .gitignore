# ============================================================
#  Git 忽略规则
#  原则：密钥、依赖、构建产物、运行时数据一律不进仓库
# ============================================================

# ---------- 密钥与环境变量 ----------
.env
.env.local
*.env
!.env.example
deploy/.env
**/application-local.yml
**/application-secret.yml

# ---------- Java ----------
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
backend/logs/
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
ai-service/data/indexes/
ai-service/data/uploads/
.pytest_cache/

# ---------- Node ----------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ---------- 便携工具链（体积大，不进仓库）----------
tools/

# ---------- IDE ----------
.idea/
*.iml
.vscode/
*.swp

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 备份与临时文件 ----------
*.bak
*.orig
*.tmp
*~

# ---------- 运行时 ----------
logs/
*.pid
