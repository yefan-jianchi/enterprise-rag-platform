# ============================================================
#  Docker Compose 环境变量模板
#  用法： cp .env.example .env  然后按需修改
#  ⚠ .env 已被 .gitignore 忽略，千万别把真实 Key 提交到仓库
# ============================================================

# ---------- 对外端口 ----------
GATEWAY_PORT=80
BACKEND_PORT=8080
AI_SERVICE_PORT=8001
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- JWT ----------
# 生产环境务必换成随机串（至少 32 字符）
JWT_SECRET=change-me-in-production-please-32chars-min

# ---------- 模型提供方 ----------
# mock      = 离线模拟，无需 Key，演示用
# deepseek  = DeepSeek（推荐，OpenAI 兼容）
# dashscope = 通义千问（阿里百炼）
# openai    = OpenAI
LLM_PROVIDER=mock
EMBED_PROVIDER=mock

# 填上 Key 后把上面 LLM_PROVIDER 改成 deepseek 即可切换真实模型
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
