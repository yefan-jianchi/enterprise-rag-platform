# ============================================================
#  AI 服务环境变量模板
#  用法： cp .env.example .env  然后按需修改
#  默认全部走本地 Mock，**不填任何 Key 也能把全链路跑通**
# ============================================================

# ---------- 服务 ----------
APP_NAME=enterprise-rag-ai-service
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ---------- 数据目录（索引/上传文件落地）----------
# DATA_DIR=./data

# ---------- 向量化 ----------
# mock      = 本地确定性向量，无需 Key（默认）
# dashscope = 通义 text-embedding-v3（1024 维）
# openai    = text-embedding-3-small（1536 维）
EMBED_PROVIDER=mock
EMBED_MODEL=mock-embed-384
EMBED_DIM=384

# ---------- 大模型（OpenAI 兼容协议）----------
# mock / deepseek / dashscope / openai
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# --- DeepSeek（推荐，性价比高）---
# 申请： https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# --- 通义千问（阿里百炼）---
# 申请： https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------- 分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=60

# ---------- 检索 ----------
TOP_K=5
CANDIDATE_K=20
RRF_K=60
SCORE_THRESHOLD=0.20
ENABLE_REWRITE=true
ENABLE_HYDE=true
ENABLE_RERANK=true
