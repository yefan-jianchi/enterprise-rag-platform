# ============================================================================
#  Lombok 全局配置
#
#  这个文件解决什么问题：Lombok 生成构造器时默认会丢掉字段上的注解，
#  导致 @RequiredArgsConstructor 生成的构造器参数上没有 @Qualifier，
#  Spring 就无法区分「同名类型的多个 Bean」（例如我们有两个 Executor：
#  documentExecutor 与 sseExecutor）——启动时会报 NoUniqueBeanDefinitionException。
#
#  copyableAnnotations 让 Lombok 把这些注记一起复制到构造器参数上，
#  这样「字段上写 @Qualifier + 类上写 @RequiredArgsConstructor」就能正常工作，
#  不需要退化成手写构造器。
# ============================================================================
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.addLombokGeneratedAnnotation = true
